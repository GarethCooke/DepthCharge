// firmware/include/secrets.h.example — copy to secrets.h and fill in.
//
//     cp firmware/include/secrets.h.example firmware/include/secrets.h
//
// secrets.h is git-ignored (see the root .gitignore). This file is the shape,
// committed so a fresh clone knows what is missing; the real one never is.
//
// Wi-Fi only. There is no provisioning UI and no captive portal in M3 — the
// brief puts both out of scope — so the credentials are compiled in, and
// changing network means a reflash. That is fine for a desk object on one
// network and is revisited only if the thing ever leaves the desk.
#pragma once

// 2.4 GHz only: the ESP32-S3 has no 5 GHz radio. If the SSID is dual-band and
// the association times out, that is the first thing to check.
inline constexpr char kWifiSsid[] = "your-ssid";
inline constexpr char kWifiPassword[] = "your-password";
