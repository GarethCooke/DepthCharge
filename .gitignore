# Build output (CMake presets write to build/<preset>; reviewers may use build/review*)
/build/
build/

# CMake user-local
CMakeUserPresets.json
compile_commands.json

# Python
__pycache__/
*.pyc
.venv/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp

# Firmware: PlatformIO build output and the Wi-Fi credentials.
# secrets.h.example IS committed — it is the shape, not the secret.
/firmware/.pio/
/firmware/include/secrets.h

# Raw serial captures (`pio device monitor -f log2file`). Hundreds of KB each and
# mostly the 1 Hz steady-state line; the bench records in hardware/ quote the
# excerpts that matter, which is the precedent bench-2026-08-09-ws-reconnect.md set.
/firmware/logs/

# Full local captures are kept untracked; only sliced traces are committed.
# (harness/replay/.gitignore also covers _local/ and *.full.ndjson explicitly.)
